---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Platform Settings & Configuration | UncosHub AI">
  <Navbar />
  <MastheadInfoStrip />
  
  <main class="flex-1 py-8 bg-[#fafafa] dark:bg-[#000000]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      
      <div class="mb-8">
        <span class="font-mono-caption text-[#0070f3] text-xs font-semibold">PREFERENCES CONTROL</span>
        <h1 class="text-3xl font-bold text-[#171717] dark:text-white tracking-tight mt-1">
          Settings & System Options
        </h1>
        <p class="text-sm text-[#71717a] dark:text-[#a1a1aa] mt-1">
          Customize dark mode, default language stream, TTS voice engine, and security preferences.
        </p>
      </div>

      <div class="space-y-6">
        
        <!-- Appearance Settings -->
        <div class="p-6 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl space-y-4">
          <h2 class="text-lg font-bold text-[#171717] dark:text-white flex items-center gap-2">
            <span>🎨</span> Appearance & Theme
          </h2>
          
          <div class="flex items-center justify-between pt-3 border-t border-[#ebebeb] dark:border-[#262626]">
            <div>
              <span class="block text-sm font-semibold text-[#171717] dark:text-white">Dark Mode</span>
              <span class="text-xs text-[#71717a] dark:text-[#a1a1aa]">Toggle high-contrast dark visual theme</span>
            </div>
            <button id="toggle-dark-settings-btn" type="button" class="px-4 py-2 bg-[#0070f3] text-white text-xs font-semibold rounded-lg shadow-sm hover:bg-[#0761d1] transition-colors cursor-pointer">
              Toggle Theme
            </button>
          </div>
        </div>

        <!-- Voice AI Engine Settings -->
        <div class="p-6 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl space-y-4">
          <h2 class="text-lg font-bold text-[#171717] dark:text-white flex items-center gap-2">
            <span>🎙️</span> Voice AI Engine Configuration
          </h2>
          
          <div class="space-y-3 pt-3 border-t border-[#ebebeb] dark:border-[#262626]">
            <div>
              <label class="block text-sm font-semibold text-[#171717] dark:text-white mb-1">Primary Indic TTS Provider</label>
              <select class="w-full max-w-md p-2.5 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded-lg text-xs font-semibold text-[#171717] dark:text-white">
                <option value="sarvam" selected>Sarvam AI Bulbul V3 (Ranked #1 for Indic Naturalness)</option>
                <option value="elevenlabs">ElevenLabs Studio Tier (English Fallback)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Security & Reset Settings -->
        <div class="p-6 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl space-y-4">
          <h2 class="text-lg font-bold text-[#171717] dark:text-white flex items-center gap-2">
            <span>🛡️</span> Security & Data Management
          </h2>
          
          <div class="flex items-center justify-between pt-3 border-t border-[#ebebeb] dark:border-[#262626]">
            <div>
              <span class="block text-sm font-semibold text-[#171717] dark:text-white">Clear Local Cache & Session</span>
              <span class="text-xs text-[#71717a] dark:text-[#a1a1aa]">Purge stored weather cache, saved bookmarks, and access tokens</span>
            </div>
            <button id="clear-cache-settings-btn" type="button" class="px-4 py-2 bg-[#fafafa] dark:bg-[#18181b] border border-[#ebebeb] dark:border-[#27272a] text-[#ee0000] text-xs font-semibold rounded-lg hover:bg-[#fee2e2] transition-colors cursor-pointer">
              Clear Cache
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.getElementById('toggle-dark-settings-btn')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  document.getElementById('clear-cache-settings-btn')?.addEventListener('click', () => {
    localStorage.clear();
    alert('Local cache and session stored data purged.');
    window.location.reload();
  });
</script>
