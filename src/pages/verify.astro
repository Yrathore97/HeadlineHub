---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import FactCheckWidget from '../components/FactCheckWidget.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Fact Check Explorer India - Fact Check Status True & News Verification | NewzWale"
  description="Use NewzWale Fact Check Explorer to verify viral WhatsApp forwards, breaking headlines, and India news claims with official PTI, PIB & RBI dispatches."
>
  <Navbar />
  <MastheadInfoStrip />
  
  <main class="flex-1 py-8 bg-surface-soft">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 mb-8">
      <div class="bg-surface-dark text-canvas dark:text-ink rounded-lg p-8 sm:p-12 relative overflow-hidden shadow-stacked-lg border border-transparent">
        <div class="absolute -right-20 -top-20 w-[400px] h-[400px] mesh-gradient-glow opacity-30 pointer-events-none"></div>
        <div class="relative z-10 max-w-3xl">
          <span class="inline-block px-3 py-1 bg-primary-strong text-on-primary font-mono-caption text-[11px] rounded-full mb-4 font-bold">
            PUBLIC AUDIT ENGINE
          </span>
          <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-1.5px] leading-tight mb-4">
            AI News Verification & Credibility Portal.
          </h1>
          <p class="text-base text-stone dark:text-body leading-relaxed">
            Verify headlines, viral WhatsApp forwards, image screenshots, or article URLs. Our engine checks wire services (PTI, ANI), official government portals (PIB, RBI, ECI), and IFCN-certified fact-checkers before issuing a verdict with cited evidence.
          </p>
        </div>
      </div>
    </div>

    <!-- Embedded Fact Check Tool Widget -->
    <FactCheckWidget />

    <!-- Verification Methodology Guide -->
    <section id="methodology" class="w-full py-12 bg-canvas border-t border-hairline">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <span class="font-mono-caption text-primary-strong mb-2 block font-semibold">TRANSPARENCY & ACCURACY DISCLOSURE</span>
        <h2 class="text-2xl font-semibold text-ink tracking-tight mb-6">
          NewzWale Verification Methodology
        </h2>

        <div class="space-y-6 text-sm text-body leading-relaxed">
          <div class="p-4 bg-surface-card border border-hairline rounded-md">
            <h3 class="font-semibold text-ink mb-1">1. Claim Isolation & Extraction</h3>
            <p>Every submitted text block, URL, or OCR image passes through a Named Entity Recognition (NER) model to isolate verifiable factual assertions from subjective opinions.</p>
          </div>

          <div class="p-4 bg-surface-card border border-hairline rounded-md">
            <h3 class="font-semibold text-ink mb-1">2. Multi-Source Evidence Cross-Referencing</h3>
            <p>Claims are weighted against tier-1 sources: wire agencies (PTI, ANI, Reuters), official government gazettes (PIB, RBI, ECI), and IFCN signatories (Alt News, BOOM, Factly). If no corroborating or debunking evidence exists in verified archives, the tool outputs <strong>Unverifiable</strong> rather than guessing.</p>
          </div>

          <div class="p-4 bg-surface-card border border-hairline rounded-md">
            <h3 class="font-semibold text-ink mb-1">3. Automated Escalation to Human Moderation</h3>
            <p>High-stakes claims involving public health emergencies, election integrity, or communal sensitivity are automatically routed to our human review desk before public archiving.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
