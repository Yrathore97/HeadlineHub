---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const contactEmail = 'yrathore.97.dhn@gmail.com';

const inquiryTypes = [
  'Claim Verification Tip',
  'Editorial Correction',
  'API & Syndication Request',
  'General Support'
];
---

<Layout title="Contact Editorial & Wire Tip Line | NewzWale">
  <Navbar />
  <MastheadInfoStrip />

  <main id="main" class="flex-1 py-12 bg-surface-soft">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <div class="mb-8">
        <span class="font-mono-caption text-primary-strong text-xs font-semibold">GET IN TOUCH</span>
        <h1 class="text-3xl font-bold text-ink tracking-tight mt-1">
          Editorial Tip Line & Inquiries
        </h1>
        <p class="text-sm text-body mt-1">
          Submit claim verification leads, report corrections, or get in touch with our editorial and AI engineering team.
        </p>
      </div>

      <div class="bg-surface-elevated border border-hairline rounded-md p-6 sm:p-8 shadow-stacked-sm">
        <h2 class="text-lg font-bold text-ink mb-2">Email the editorial desk</h2>
        <p class="text-sm text-body leading-relaxed">
          Write to us directly and your message lands with the editors and engineers who run the wire. Include source links and the exact claim text where you can — it makes verification much faster.
        </p>

        <ul class="mt-4 space-y-2 text-xs text-body">
          {inquiryTypes.map((type) => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
              {type}
            </li>
          ))}
        </ul>

        <a
          href={`mailto:${contactEmail}`}
          class="btn-primary inline-flex items-center gap-2 px-6 mt-6 text-sm break-all"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          {contactEmail}
        </a>

        <p class="mt-4 text-xs text-mute leading-relaxed">
          We read every message. Corrections to published summaries are prioritised over all other inquiries.
        </p>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
