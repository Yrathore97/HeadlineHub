---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Editorial & Wire Tip Line | NewzWale">
  <Navbar />
  <MastheadInfoStrip />
  
  <main class="flex-1 py-12 bg-[#fafafa] dark:bg-[#000000]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      
      <div class="mb-8">
        <span class="font-mono-caption text-[#1d4ed8] dark:text-[#60a5fa] text-xs font-semibold">GET IN TOUCH</span>
        <h1 class="text-3xl font-bold text-[#171717] dark:text-white tracking-tight mt-1">
          Editorial Tip Line & Inquiries
        </h1>
        <p class="text-sm text-[#71717a] dark:text-[#a1a1aa] mt-1">
          Submit claim verification leads, report corrections, or get in touch with our editorial and AI engineering team.
        </p>
      </div>

      <div class="bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl p-6 sm:p-8 shadow-sm">
        <form id="contact-form" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-[#171717] dark:text-white mb-1">Your Full Name</label>
            <input type="text" required placeholder="e.g. Rahul Sharma" class="w-full p-3 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded-xl text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#2563eb]" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#171717] dark:text-white mb-1">Email Address</label>
            <input type="email" required placeholder="name@example.com" class="w-full p-3 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded-xl text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#2563eb]" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#171717] dark:text-white mb-1">Subject / Inquiry Type</label>
            <select class="w-full p-3 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded-xl text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#2563eb]">
              <option value="claim">Claim Verification Tip</option>
              <option value="correction">Editorial Correction</option>
              <option value="api">API & Syndication Request</option>
              <option value="general">General Support</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#171717] dark:text-white mb-1">Message Details</label>
            <textarea rows="5" required placeholder="Provide links, claim text, or message details..." class="w-full p-3 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded-xl text-xs text-[#171717] dark:text-white focus:outline-none focus:border-[#2563eb]"></textarea>
          </div>

          <button type="submit" class="w-full py-3 bg-[#2563eb] hover:bg-[#1d4ed8] text-white font-bold text-xs rounded-xl shadow-sm transition-all cursor-pointer">
            Submit Inquiries
          </button>
        </form>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Thank you! Your message has been routed to the NewzWale editorial desk.');
    (e.target as HTMLFormElement).reset();
  });
</script>
