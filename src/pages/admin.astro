---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import AdminDesk from '../components/AdminDesk.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Operations Desk & Moderation Control | HeadlineHub AI">
  <Navbar />
  
  <main class="flex-1 py-6 bg-[#fafafa] dark:bg-[#000000] transition-colors duration-200">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 mb-4">
      <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#262626] pb-4">
        <div>
          <h1 class="text-2xl font-bold text-[#171717] dark:text-white tracking-tight">HeadlineHub Admin Portal</h1>
          <p class="text-xs text-[#888888]">Monitor crawlers, human review queues, user permissions, and real-time revenue analytics.</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-1 bg-[#aaffec] dark:bg-[#064e3b] text-[#29bc9b] dark:text-[#34d399] text-xs font-mono font-medium rounded border border-[#29bc9b]/20 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-[#29bc9b] animate-ping"></span>
            System Health: 100%
          </span>
        </div>
      </div>
    </div>

    <AdminDesk />
  </main>

  <Footer />
</Layout>
