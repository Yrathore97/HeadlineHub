---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us & Transparency Disclosure | UncosHub AI">
  <Navbar />
  <MastheadInfoStrip />
  
  <main class="flex-1 py-12 bg-[#fafafa] dark:bg-[#000000]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      
      <div>
        <span class="font-mono-caption text-[#0070f3] text-xs font-semibold">MISSION & TRANSPARENCY</span>
        <h1 class="text-3xl sm:text-5xl font-bold text-[#171717] dark:text-white tracking-tight mt-1">
          India's Autonomous Multilingual Media Network.
        </h1>
        <p class="text-base text-[#71717a] dark:text-[#a1a1aa] mt-3 leading-relaxed">
          UncosHub AI was built to combat misinformation and deliver instant, neutral, 24/7 verified news across 10 Indian languages. By combining official wire streams (PTI, ANI, PIB) with automated fact-checking and Sarvam AI voice synthesis, we empower millions of readers with transparent news.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl">
          <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-2">
            100% Citation Grounding
          </h2>
          <p class="text-xs text-[#71717a] dark:text-[#a1a1aa] leading-relaxed">
            Every summary and fact-check verdict generated by UncosHub AI is strictly bound to primary sources, wire dispatches, official government releases (PIB, RBI, ECI), and IFCN-certified signatories.
          </p>
        </div>

        <div class="p-6 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl">
          <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-2">
            Sarvam AI Voice Integration
          </h2>
          <p class="text-xs text-[#71717a] dark:text-[#a1a1aa] leading-relaxed">
            Powered by Sarvam AI’s Bulbul V3 model, UncosHub AI delivers natural, high-fidelity audio synthesis tuned specifically for Indic phonetics, numbers, and regional entities across Hindi, Bengali, Tamil, Telugu, Marathi, and more.
          </p>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
