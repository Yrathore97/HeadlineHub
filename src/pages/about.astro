---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---

<Layout title="About Us & Transparency Disclosure | NewzWale">
  <Navbar />
  <MastheadInfoStrip />
  
  <main class="flex-1 py-12 bg-surface-soft">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">

      <div>
        <span class="font-mono-caption text-primary-strong text-xs font-semibold">MISSION & TRANSPARENCY</span>
        <h1 class="text-3xl sm:text-5xl font-bold text-ink tracking-tight mt-1">
          India's Autonomous Multilingual Media Network.
        </h1>
        <p class="text-base text-body mt-3 leading-relaxed">
          NewzWale was built to combat misinformation and deliver instant, neutral, 24/7 verified news across 10 Indian languages. By combining official wire streams (PTI, ANI, PIB) with automated fact-checking and Sarvam AI voice synthesis, we empower millions of readers with transparent news.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 bg-surface-elevated border border-hairline rounded-md">
          <h2 class="text-lg font-bold text-ink mb-2">
            100% Citation Grounding
          </h2>
          <p class="text-xs text-body leading-relaxed">
            Every summary and fact-check verdict generated by NewzWale is strictly bound to primary sources, wire dispatches, official government releases (PIB, RBI, ECI), and IFCN-certified signatories.
          </p>
        </div>

        <div class="p-6 bg-surface-elevated border border-hairline rounded-md">
          <h2 class="text-lg font-bold text-ink mb-2">
            Sarvam AI Voice Integration
          </h2>
          <p class="text-xs text-body leading-relaxed">
            Powered by Sarvam AI’s Bulbul V3 model, NewzWale delivers natural, high-fidelity audio synthesis tuned specifically for Indic phonetics, numbers, and regional entities across Hindi, Bengali, Tamil, Telugu, Marathi, and more.
          </p>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
