---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { id: 'india', name: 'India', icon: '🇮🇳', count: '1,420 Articles Today', description: 'National headlines, Parliament proceedings, union policy decisions, and state news.' },
  { id: 'world', name: 'World', icon: '🌐', count: '890 Articles Today', description: 'Global geopolitics, international relations, trade agreements, and foreign affairs.' },
  { id: 'politics', name: 'Politics', icon: '🏛️', count: '1,150 Articles Today', description: 'Election coverage, party press releases, legislative debates, and governance.' },
  { id: 'technology', name: 'Technology', icon: '💻', count: '640 Articles Today', description: 'AI innovations, startup funding, cybersecurity, semiconductors, and consumer tech.' },
  { id: 'finance', name: 'Finance', icon: '📈', count: '920 Articles Today', description: 'Stock markets, RBI monetary policy, taxation, Sensex/Nifty, and personal finance.' },
  { id: 'business', name: 'Business', icon: '🏢', count: '780 Articles Today', description: 'Corporate earnings, mergers & acquisitions, industry trends, and trade.' },
  { id: 'sports', name: 'Sports', icon: '🏏', count: '830 Articles Today', description: 'Cricket tournaments, Olympic sports, ISL football, badminton, and athletics.' },
  { id: 'entertainment', name: 'Entertainment', icon: '🎬', count: '510 Articles Today', description: 'Cinema news, OTT releases, box office reports, and cultural features.' },
  { id: 'science', name: 'Science', icon: '🚀', count: '410 Articles Today', description: 'ISRO space missions, defense research, renewable energy, and scientific discoveries.' },
  { id: 'health', name: 'Health', icon: '🏥', count: '390 Articles Today', description: 'Public health advisories, medical research, wellness, and pharmaceutical updates.' },
];
---

<Layout title="News Categories Directory | NewzWale">
  <Navbar />
  <MastheadInfoStrip />
  
  <main class="flex-1 py-8 bg-[#fafafa] dark:bg-[#000000]">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
      
      <div class="mb-8">
        <span class="font-mono-caption text-[#1d4ed8] dark:text-[#60a5fa] text-xs font-semibold">CATEGORIES DIRECTORY</span>
        <h1 class="text-3xl font-bold text-[#171717] dark:text-white tracking-tight mt-1">
          Explore News by Topic
        </h1>
        <p class="text-sm text-[#71717a] dark:text-[#a1a1aa] mt-1">
          Browse verified coverage across 10 primary verticals continuously updated by our autonomous AI wire network.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a href={`/news?category=${cat.id}`} class="p-6 bg-white dark:bg-[#0a0a0a] border border-[#bfdbfe] dark:border-[#1e293b] rounded-2xl shadow-sm hover:border-[#2563eb] hover:shadow-md transition-all group">
            <div class="flex items-center justify-between mb-3">
              <span class="text-3xl">{cat.icon}</span>
              <span class="px-2.5 py-1 bg-[#fafafa] dark:bg-[#18181b] border border-[#ebebeb] dark:border-[#27272a] text-[#52525b] dark:text-[#a1a1aa] font-mono text-[10px] rounded-full">
                {cat.count}
              </span>
            </div>
            <h2 class="text-xl font-bold text-[#171717] dark:text-white group-hover:text-[#ca8a04] dark:group-hover:text-[#facc15] transition-colors mb-2">
              {cat.name}
            </h2>
            <p class="text-xs text-[#71717a] dark:text-[#a1a1aa] leading-relaxed">
              {cat.description}
            </p>
          </a>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>
