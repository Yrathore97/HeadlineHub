---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MastheadInfoStrip from '../components/MastheadInfoStrip.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const sections = [
  {
    heading: 'Information We Collect',
    body: 'NewzWale collects limited data required to personalize and secure your news experience. This includes account credentials (name and email when you sign up), preferred language selection, saved bookmarks, and anonymized browsing analytics used to improve content delivery. We do not collect data unrelated to operating our service.'
  },
  {
    heading: 'How We Use Your Information',
    body: 'Your information is used solely to operate the NewzWale service: authenticating your account, persisting your personalized feed and language preferences, delivering your saved bookmarks across devices, and generating aggregated, non-identifying analytics. We never sell your personal data to third parties.'
  },
  {
    heading: 'Cookies & Local Storage',
    body: 'NewzWale uses browser local storage to remember your theme, language preference, and authentication session. Minimal cookies may be used for essential functionality and analytics. You can clear this data at any time through your browser settings without impacting basic access to headlines.'
  },
  {
    heading: 'Third-Party Services',
    body: 'We integrate with trusted providers such as Google for authentication (OAuth), cloud content delivery networks, and analytics platforms. These providers process data under their own privacy policies. We do not authorize them to sell or misuse your data.'
  },
  {
    heading: 'Data Retention & Security',
    body: 'We retain account data for as long as your account remains active or as required by law. All transmissions are encrypted in transit, and access to personal data is restricted to authorized personnel. Industry-standard safeguards protect stored information from unauthorized access or disclosure.'
  },
  {
    heading: 'Your Rights & Choices',
    body: 'You may access, correct, export, or delete your personal information at any time from your account settings, or by contacting our editorial desk. You may also withdraw consent for analytics and clear local storage data. Requests are processed in accordance with applicable data protection regulations.'
  },
  {
    heading: 'Changes to This Policy',
    body: 'We may update this Privacy Policy periodically to reflect changes in our practices or legal obligations. Material changes will be communicated prominently on this page and via our news feed. Continued use of NewzWale after updates constitutes acceptance of the revised policy.'
  },
  {
    heading: 'Contact Us',
    body: 'For privacy-related inquiries, corrections, or data requests, please reach out through our Contact page. Our editorial and data-protection team will respond within a reasonable timeframe.'
  }
];

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy | NewzWale",
  "url": Astro.site ? new URL('/privacy', Astro.site).toString() : '/privacy',
  "isPartOf": {
    "@type": "WebSite",
    "name": "NewzWale",
    "url": "https://newzwale.com"
  }
};
---

<Layout title="Privacy Policy | NewzWale">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(privacySchema)} />

  <Navbar />
  <MastheadInfoStrip />

  <main class="flex-1 py-12 bg-[#fafafa] dark:bg-[#000000]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="mb-10">
        <span class="font-mono-caption text-[#1d4ed8] dark:text-[#60a5fa] text-xs font-semibold">LEGAL & PRIVACY</span>
        <h1 class="text-3xl sm:text-5xl font-bold text-[#171717] dark:text-white tracking-tight mt-1">
          Privacy Policy
        </h1>
        <p class="text-base text-[#71717a] dark:text-[#a1a1aa] mt-3 leading-relaxed">
          Last updated: August 2026. NewzWale ("we", "our", "us") is committed to protecting your privacy and handling your personal data with transparency. This policy explains what we collect, how we use it, and the choices you have.
        </p>
      </div>

      <div class="space-y-6">
        {sections.map((section, index) => (
          <div class="p-6 bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-2xl">
            <div class="flex items-center gap-3 mb-2">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[#dbeafe] dark:bg-[#172554] text-[#1d4ed8] dark:text-[#60a5fa] text-[11px] font-mono font-bold flex items-center justify-center">
                {index + 1}
              </span>
              <h2 class="text-base font-bold text-[#171717] dark:text-white">{section.heading}</h2>
            </div>
            <p class="pl-9 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
              {section.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>