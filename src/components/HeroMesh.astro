---
---

<section class="relative w-full overflow-hidden border-b border-hairline mesh-gradient-bg py-8 sm:py-12 md:py-16 transition-colors duration-200">
  <!-- Mesh Glow Backdrop -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] sm:w-[800px] h-[300px] sm:h-[350px] mesh-gradient-glow opacity-60 pointer-events-none"></div>

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 relative z-10">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-elevated/90 border border-hairline rounded-full shadow-stacked-sm mb-4 sm:mb-5 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        <span class="font-mono-caption text-primary-strong text-[10px] sm:text-[11px] font-semibold tracking-wider">
          MEDIA NETWORK • ONLY FACTS NEWS
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-semibold text-ink tracking-[-0.8px] sm:tracking-[-2px] leading-snug sm:leading-[1.05] mb-4 sm:mb-5">
        Search Real-Time News, in Your Language.
      </h1>

      <!-- Subtitle -->
      <p class="text-xs sm:text-base md:text-lg text-body max-w-2xl font-normal leading-relaxed mb-6 sm:mb-8 px-2 sm:px-0">
        NewzWale collects live headlines from Indian news sources. Search any topic below, or use the Fact Check tab to verify a specific claim.
      </p>

      <!-- News Search Bar -->
      <div class="w-full max-w-2xl bg-surface-elevated border border-hairline rounded-md p-1.5 sm:p-2 shadow-stacked-md mb-6 sm:mb-8 hover:border-primary focus-within:border-primary-strong focus-within:ring-1 focus-within:ring-primary-strong transition-colors">
        <form id="hero-search-form" class="flex flex-col sm:flex-row items-center gap-2">
          <div class="relative w-full flex-1 flex items-center pl-3 min-w-0">
            <svg class="w-4 h-4 text-mute shrink-0 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            <label for="hero-query" class="sr-only">Search for news, e.g. "India cricket" or "budget 2026"</label>
            <input
              id="hero-query"
              type="text"
              name="query"
              autocomplete="off"
              spellcheck="false"
              placeholder="Search for news… e.g. India cricket, budget 2026"
              class="w-full min-w-0 bg-transparent text-xs sm:text-sm text-ink placeholder:text-mute border-none focus:outline-none py-1.5 sm:py-2"
              required
            />
          </div>
          <button type="submit" class="w-full sm:w-auto px-4 sm:px-5 py-2 sm:py-2.5 bg-primary-strong hover:bg-primary-pressed text-on-primary text-xs font-bold rounded-md transition-colors flex items-center justify-center gap-2 shrink-0 cursor-pointer shadow-stacked-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
            <svg class="w-3.5 h-3.5 text-on-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            Search
          </button>
        </form>
      </div>

      <!-- Feature Pill Stats -->
      <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-2 sm:gap-6 text-xs text-body">
        <div class="flex items-center gap-1.5 font-medium">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary-strong" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Live Headline Stream
        </div>
        <span class="hidden sm:inline text-stone">•</span>
        <div class="flex items-center gap-1.5 font-medium">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary-strong" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          13 Languages
        </div>
        <span class="hidden sm:inline text-stone">•</span>
        <div class="flex items-center gap-1.5 font-medium">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-primary-strong" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          Zero Copyright Infringement
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('hero-search-form') as HTMLFormElement | null;
  const input = document.getElementById('hero-query') as HTMLInputElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const query = input?.value.trim();
    if (!query) return;

    const languageSelect = document.getElementById('language-select') as HTMLSelectElement | null;
    const language = languageSelect?.value || 'en';

    window.dispatchEvent(new CustomEvent('news-search', { detail: { query, language } }));
  });
</script>
