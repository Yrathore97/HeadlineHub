---
import LogoIcon from './LogoIcon.astro';
---

<footer class="w-full bg-canvas border-t border-hairline py-8 sm:py-12 text-xs text-body transition-colors duration-200">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 mb-8 sm:mb-10">

      <!-- Brand & Mission -->
      <div class="space-y-3 sm:col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <LogoIcon className="w-7 h-7" />
          <div class="flex flex-col">
            <span class="font-semibold text-sm text-ink leading-none">NewzWale</span>
            <span class="font-mono-caption text-[9px] text-primary-strong font-semibold tracking-widest leading-none mt-0.5">Only Facts News</span>
          </div>
        </div>
        <p class="text-xs text-mute leading-relaxed">
          India & South Asia's 24/7 autonomous news ecosystem. Discovering, verifying, summarizing, and distributing news across 10 Indian languages.
        </p>
        <div class="text-[11px] font-mono text-mute">
          Operational Engine Version 4.2.0-IN
        </div>
      </div>

      <!-- Column 1: Coverage & Feed -->
      <div>
        <h4 class="font-mono-caption text-ink mb-2.5 sm:mb-3 font-semibold">COVERAGE REGIONS</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-ink transition-colors">National News India</a></li>
          <li><a href="/" class="hover:text-ink transition-colors">Karnataka & South Asia</a></li>
          <li><a href="/" class="hover:text-ink transition-colors">Maharashtra & Western Region</a></li>
          <li><a href="/" class="hover:text-ink transition-colors">Delhi NCR & North Edition</a></li>
          <li><a href="/" class="hover:text-ink transition-colors">Hyperlocal District Wire</a></li>
        </ul>
      </div>

      <!-- Column 2: AI Verification & Trust -->
      <div>
        <h4 class="font-mono-caption text-ink mb-2.5 sm:mb-3 font-semibold">FACT CHECK & TRUST</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/verify" class="hover:text-ink transition-colors">Submit Claim to Fact Checker</a></li>
          <li><a href="/verify" class="hover:text-ink transition-colors">Public Verification Methodology</a></li>
          <li><a href="/verify" class="hover:text-ink transition-colors">Sources Checked Matrix (PTI, ANI, PIB)</a></li>
        </ul>
      </div>

      <!-- Column 3: Legal & Company -->
      <div>
        <h4 class="font-mono-caption text-ink mb-2.5 sm:mb-3 font-semibold">LEGAL & COMPANY</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/privacy" class="hover:text-ink transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-ink transition-colors">Terms & Conditions</a></li>
          <li><a href="/about" class="hover:text-ink transition-colors">About Us</a></li>
          <li><a href="/contact" class="hover:text-ink transition-colors">Contact Us</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Compliance Strip -->
    <div class="pt-6 border-t border-hairline text-[11px] text-mute">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
        <div>
          © 2026 NewzWale. All rights reserved. Headlines, summaries, and source attributions only.
        </div>
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
            API Services Nominal
          </span>
          <span>Made with Astro & Tailwind CSS</span>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-4 gap-y-1.5 mt-4">
        <a href="/privacy" class="hover:text-ink transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-ink transition-colors">Terms &amp; Conditions</a>
        <a href="/about" class="hover:text-ink transition-colors">About Us</a>
        <a href="/contact" class="hover:text-ink transition-colors">Contact Us</a>
      </div>
    </div>
  </div>
</footer>
