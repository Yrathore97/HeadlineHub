---
---
<section id="social-studio" class="w-full py-12 bg-[#fafafa] dark:bg-[#050505] border-b border-[#ebebeb] dark:border-[#262626] transition-colors duration-200">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      
      <!-- Section Header -->
      <div class="flex flex-col items-center text-center mb-8">
        <span class="font-mono-caption text-[#eb367f]">PHASE 4 & 5 • AUTOMATED OMNICHANNEL DISTRIBUTION</span>
        <h2 class="text-2xl sm:text-4xl font-semibold text-[#171717] dark:text-white tracking-[-1.28px] mb-2">
          AI Video & Social Media Studio
        </h2>
        <p class="text-sm text-[#4d4d4d] dark:text-[#a1a1a1] max-w-xl">
          HeadlineHub AI automatically reformats verified news into Instagram Carousels, X Threads, WhatsApp Broadcasts, and YouTube Shorts.
        </p>
      </div>

      <!-- Studio Controls Container -->
      <div class="bg-white dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-xl p-5 sm:p-6 shadow-stacked-md">
        
        <!-- Platform Switcher Tabs -->
        <div class="flex items-center gap-2 border-b border-[#ebebeb] dark:border-[#262626] pb-4 mb-6 overflow-x-auto">
          <button id="studio-tab-insta" class="studio-tab active px-3.5 py-1.5 text-xs font-semibold text-white dark:text-[#171717] bg-[#171717] dark:bg-white rounded-md shadow-sm">
            📸 Instagram Carousel (1080x1350)
          </button>
          <button id="studio-tab-x" class="studio-tab px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white rounded-md">
            🐦 X (Twitter) Thread
          </button>
          <button id="studio-tab-wa" class="studio-tab px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white rounded-md">
            💬 WhatsApp / Telegram Broadcast
          </button>
          <button id="studio-tab-video" class="studio-tab px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white rounded-md flex items-center gap-1">
            🎬 AI Reel Video Script
          </button>
        </div>

        <!-- Dynamic Output Preview Box -->
        <div id="studio-preview-box" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Mock Card Output (Instagram Style) -->
          <div class="bg-gradient-to-br from-[#171717] to-[#262626] text-white p-6 rounded-xl relative flex flex-col justify-between h-[360px] shadow-lg border border-[#333333]">
            
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-[#50e3c2] flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-[#50e3c2]"></span>
                HEADLINEHUB.AI
              </span>
              <span class="text-[#888888]">SLIDE 1/5</span>
            </div>

            <div class="my-auto">
              <div class="inline-block px-2.5 py-0.5 bg-[#2563eb] text-white text-[10px] font-bold rounded uppercase mb-3">
                BUSINESS & POLICY
              </div>
              <h3 class="text-xl font-bold tracking-tight text-white mb-2 leading-snug">
                RBI Keeps Repo Rate Steady at 6.5%
              </h3>
              <p class="text-xs text-[#a1a1a1] leading-relaxed">
                Swipe left for key takeaways on inflation targets, home loan EMIs, and GDP projections for 2026-27.
              </p>
            </div>

            <div class="pt-3 border-t border-[#333333] flex items-center justify-between text-[11px] text-[#888888]">
              <span>Verified Source: RBI Gazette</span>
              <span>@HeadlineHubAI</span>
            </div>
          </div>

          <!-- Automation Config Controls -->
          <div class="flex flex-col justify-between space-y-4">
            <div>
              <h4 class="text-xs font-mono-caption text-[#888888] mb-2">GENERATION PARAMETERS</h4>
              
              <div class="space-y-3">
                <div>
                  <label class="block text-xs font-medium text-[#171717] dark:text-white mb-1">Target Audience Language</label>
                  <select class="w-full bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded p-2 text-xs text-[#171717] dark:text-white">
                    <option>English (Global Standard)</option>
                    <option>Hindi (हिंदी)</option>
                    <option>Kannada (ಕನ್ನಡ)</option>
                    <option>Tamil (தமிழ்)</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-medium text-[#171717] dark:text-white mb-1">Voiceover Tone (For Reels & Shorts)</label>
                  <select class="w-full bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded p-2 text-xs text-[#171717] dark:text-white">
                    <option>Authoritative News Anchor (Deep Male)</option>
                    <option>Conversational Tech Journalist (Female)</option>
                    <option>High-Energy Sports Commentator</option>
                  </select>
                </div>

                <div class="p-3 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] rounded text-xs space-y-1">
                  <div class="font-medium text-[#171717] dark:text-white">Automatic Publishing Webhook</div>
                  <div class="text-[#888888]">Connected Channels: Instagram (@headlinehub.ai), X (@headlinehub_news), Telegram Channel</div>
                </div>
              </div>
            </div>

            <button class="w-full py-2.5 bg-[#171717] dark:bg-white hover:bg-[#333333] dark:hover:bg-[#e5e5e5] text-white dark:text-[#171717] text-xs font-medium rounded-lg shadow-sm transition-colors flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-[#eb367f]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Render & Publish Social Post
            </button>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
