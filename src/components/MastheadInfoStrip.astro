---
import { LANGUAGES, isValidLanguage, DEFAULT_LANGUAGE } from '../lib/news/languages';

const rawLanguage = Astro.url.searchParams.get('language');
const currentLanguage = isValidLanguage(rawLanguage) ? rawLanguage : DEFAULT_LANGUAGE;
---

<div id="masthead-info-strip" class="relative w-full bg-surface-dark text-canvas dark:text-ink py-1.5 px-4 font-mono-caption transition-colors duration-200">
  <div id="masthead-strip-scroll" class="max-w-[1400px] mx-auto flex items-center justify-between gap-4 overflow-x-auto no-scrollbar">

    <!-- Left: Weather, Location & Date. This bar stays dark in both site
         themes, so every text colour here is the "always-dark-band" pair
         (light-mode token / dark:ink), never a token that inverts. -->
    <div class="flex items-center gap-4 shrink-0">
      <div id="weather-widget-container" class="flex items-center gap-1.5">
        <span id="weather-location" class="font-semibold text-canvas dark:text-ink">New Delhi</span>
        <span class="opacity-70">·</span>
        <span id="weather-temp" class="font-semibold text-primary">31°C</span>
        <span id="weather-condition">☀️</span>
      </div>
      <span class="opacity-70" id="masthead-date-text">Tue, Aug 4, 2026</span>
      <span id="ticker" hidden class="opacity-80 whitespace-nowrap"></span>
    </div>

    <!-- Right: Language, Saved, Theme -->
    <div class="flex items-center gap-4 shrink-0">
      <label class="flex items-center gap-1.5">
        <span class="opacity-70 hidden sm:inline">Language</span>
        <select
          id="language-select"
          aria-label="Choose the language of news headlines"
          title="Changes the language of news headlines, not the site interface"
          class="appearance-none bg-surface-dark text-canvas dark:text-ink border border-charcoal dark:border-hairline-soft rounded-md font-mono-caption px-1.5 py-0.5 cursor-pointer focus:outline-none focus:ring-1 focus:ring-primary-strong"
        >
          {LANGUAGES.map((lang) => (
            <option value={lang.code} selected={lang.code === currentLanguage}>{lang.name}</option>
          ))}
        </select>
      </label>

      <button
        type="button"
        id="saved-drawer-toggle"
        aria-label="View saved articles"
        aria-expanded="false"
        aria-controls="saved-drawer"
        class="bg-transparent border-none text-canvas dark:text-ink hover:text-primary font-mono-caption uppercase cursor-pointer"
      >
        Saved (<span data-saved-count>0</span>)
      </button>

      <button
        type="button"
        class="theme-toggle-trigger bg-transparent border-none text-canvas dark:text-ink hover:text-primary font-mono-caption uppercase cursor-pointer"
      >
        <span class="block dark:hidden">Light</span>
        <span class="hidden dark:block">Dark</span>
      </button>
    </div>

  </div>
  <div id="masthead-strip-fade" class="pointer-events-none absolute inset-y-0 right-0 w-10 bg-gradient-to-l from-surface-dark to-transparent transition-opacity duration-200" aria-hidden="true"></div>
</div>

<script>
  const WEATHER_CACHE_KEY = 'newzwale_weather_cache';
  const WEATHER_TTL = 15 * 60 * 1000; // 15 minutes TTL

  // Locale mapper for dates
  const LANG_LOCALE_MAP: Record<string, string> = {
    'en': 'en-IN',
    'hi': 'hi-IN',
    'bn': 'bn-IN',
    'mr': 'mr-IN',
    'te': 'te-IN',
    'ta': 'ta-IN',
    'gu': 'gu-IN',
    'kn': 'kn-IN',
    'ml': 'ml-IN',
    'pa': 'pa-IN',
    'or': 'or-IN',
    'as': 'as-IN',
    'ur': 'ur-IN'
  };

  function updateMastheadDate(langCode: string = 'en') {
    const dateTextEl = document.getElementById('masthead-date-text');
    if (!dateTextEl) return;

    try {
      const locale = LANG_LOCALE_MAP[langCode] || 'en-IN';
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric'
      };
      dateTextEl.innerText = now.toLocaleDateString(locale, options);
    } catch (e) {
      dateTextEl.innerText = new Date().toDateString();
    }
  }

  // WMO Weather code interpreter
  function getWMOWeatherDescription(code: number): { text: string; icon: string } {
    if (code === 0) return { text: 'Clear', icon: '☀️' };
    if (code === 1 || code === 2) return { text: 'Partly Cloudy', icon: '⛅' };
    if (code === 3) return { text: 'Overcast', icon: '☁️' };
    if (code >= 45 && code <= 48) return { text: 'Foggy', icon: '🌫️' };
    if (code >= 51 && code <= 67) return { text: 'Drizzle/Rain', icon: '🌧️' };
    if (code >= 71 && code <= 77) return { text: 'Snow', icon: '❄️' };
    if (code >= 80 && code <= 82) return { text: 'Showers', icon: '🌦️' };
    if (code >= 95) return { text: 'Thunderstorm', icon: '🌩️' };
    return { text: 'Fair', icon: '🌡️' };
  }

  async function fetchWeather(lat: number, lon: number, cityName?: string) {
    const weatherLoc = document.getElementById('weather-location');
    const weatherTemp = document.getElementById('weather-temp');
    const weatherCond = document.getElementById('weather-condition');

    try {
      const weatherRes = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`,
        { signal: AbortSignal.timeout(4000) }
      );

      if (!weatherRes.ok) throw new Error('Weather API error');
      const weatherData = (await weatherRes.json()) as {
        current_weather?: { temperature: number; weathercode: number };
      };
      const current = weatherData.current_weather;

      if (!current) throw new Error('No weather data');

      const temp = Math.round(current.temperature);
      const { text, icon } = getWMOWeatherDescription(current.weathercode);
      const name = cityName || 'Local';

      if (weatherLoc) weatherLoc.innerText = name;
      if (weatherTemp) weatherTemp.innerText = `${temp}°C`;
      if (weatherCond) weatherCond.innerText = `${icon} ${text}`;

      // Cache weather in localStorage
      localStorage.setItem(WEATHER_CACHE_KEY, JSON.stringify({
        timestamp: Date.now(),
        location: name,
        temp: `${temp}°C`,
        condition: `${icon} ${text}`
      }));

    } catch (err) {
      // Graceful degradation: retain fallback values without error
      if (weatherLoc && !weatherLoc.innerText) weatherLoc.innerText = 'New Delhi';
    }
  }

  async function fetchWeatherWithGeocoding(lat: number, lon: number, defaultName?: string) {
    let resolvedCity = defaultName || '';
    if (!resolvedCity || resolvedCity === 'Your Location' || resolvedCity === 'Local') {
      try {
        const geoRes = await fetch(
          `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=en`,
          { signal: AbortSignal.timeout(3000) }
        );
        if (geoRes.ok) {
          const geoData = (await geoRes.json()) as {
            city?: string;
            locality?: string;
            principalSubdivision?: string;
            countryName?: string;
          };
          resolvedCity = geoData.city || geoData.locality || geoData.principalSubdivision || geoData.countryName || '';
        }
      } catch (e) {}
    }
    if (!resolvedCity) resolvedCity = 'New Delhi';

    await fetchWeather(lat, lon, resolvedCity);
  }

  async function detectLocationByIP(): Promise<boolean> {
    try {
      const ipRes = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(3500) });
      if (ipRes.ok) {
        const data = (await ipRes.json()) as {
          latitude?: number;
          longitude?: number;
          city?: string;
          region?: string;
        };
        if (data.latitude && data.longitude) {
          const cityName = data.city || data.region || 'Local';
          await fetchWeather(data.latitude, data.longitude, cityName);
          return true;
        }
      }
    } catch (e) {}
    return false;
  }

  function initWeather() {
    // Check localStorage cache
    const cached = localStorage.getItem(WEATHER_CACHE_KEY);
    if (cached) {
      try {
        const parsed = JSON.parse(cached);
        if (parsed.location && parsed.location !== 'Your Location' && Date.now() - parsed.timestamp < WEATHER_TTL) {
          const weatherLoc = document.getElementById('weather-location');
          const weatherTemp = document.getElementById('weather-temp');
          const weatherCond = document.getElementById('weather-condition');
          if (weatherLoc) weatherLoc.innerText = parsed.location;
          if (weatherTemp) weatherTemp.innerText = parsed.temp;
          if (weatherCond) weatherCond.innerText = parsed.condition;
          return;
        }
      } catch (e) {}
    }

    // Try Browser Geolocation
    if ('geolocation' in navigator) {
      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          await fetchWeatherWithGeocoding(pos.coords.latitude, pos.coords.longitude);
        },
        async () => {
          // Geolocation denied/failed -> try IP detection
          const ok = await detectLocationByIP();
          if (!ok) fetchWeather(28.6139, 77.2090, 'New Delhi');
        },
        { timeout: 4000 }
      );
    } else {
      detectLocationByIP().then(ok => {
        if (!ok) fetchWeather(28.6139, 77.2090, 'New Delhi');
      });
    }
  }

  // Initialize on DOM load
  document.addEventListener('DOMContentLoaded', () => {
    const savedLang = localStorage.getItem('userLanguage') || 'en';
    updateMastheadDate(savedLang);
    initWeather();
  });

  // Edge fade hint: hide once scrolled to the end, or if there's nothing to
  // scroll to begin with.
  const stripScroll = document.getElementById('masthead-strip-scroll');
  const stripFade = document.getElementById('masthead-strip-fade');
  if (stripScroll && stripFade) {
    const updateStripFade = () => {
      const atEnd = stripScroll.scrollLeft + stripScroll.clientWidth >= stripScroll.scrollWidth - 1;
      stripFade.style.opacity = atEnd ? '0' : '1';
    };
    updateStripFade();
    stripScroll.addEventListener('scroll', updateStripFade, { passive: true });
    window.addEventListener('resize', updateStripFade);

    // One-time "peek" nudge on load, same as the category strip.
    if (stripScroll.scrollWidth > stripScroll.clientWidth) {
      setTimeout(() => {
        stripScroll.scrollTo({ left: 56, behavior: 'smooth' });
        setTimeout(() => stripScroll.scrollTo({ left: 0, behavior: 'smooth' }), 450);
      }, 600);
    }
  }

  // Listen to global language change events
  window.addEventListener('language-changed', (e: any) => {
    const { langCode } = e.detail;
    updateMastheadDate(langCode);
  });

  // Live market indices. The strip stays hidden unless real quotes arrive -
  // never show invented numbers.
  type Quote = { price: number; changePct: number | null };

  fetch('/api/ticker')
    .then((r) => (r.ok ? (r.json() as Promise<{ sensex: Quote; nifty: Quote }>) : Promise.reject(new Error('ticker unavailable'))))
    .then((d) => {
      const el = document.getElementById('ticker');
      if (!el) return;
      const fmt = (n: Quote, label: string) =>
        `${label} ${n.price.toFixed(2)}${
          n.changePct === null ? '' : ` (${n.changePct >= 0 ? '+' : ''}${n.changePct.toFixed(2)}%)`
        }`;
      el.textContent = `${fmt(d.sensex, 'SENSEX')} · ${fmt(d.nifty, 'NIFTY')}`;
      el.hidden = false;
    })
    .catch(() => {
      /* stays hidden - never show invented numbers */
    });

  // Saved-articles drawer lives in its own component; this just asks it to
  // toggle rather than reaching into its DOM.
  document.getElementById('saved-drawer-toggle')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('nz-saved-drawer-toggle'));
  });
</script>
