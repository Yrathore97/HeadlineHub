---
interface Props {
  className?: string;
}

const { className = "w-8 h-8" } = Astro.props;
---

<svg class={`${className} shrink-0`} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Outer Royal Blue Rounded Box Background -->
  <rect width="100" height="100" rx="22" fill="#2563eb" />

  <!-- Left Folded Newspaper Page -->
  <path 
    d="M 27 38 C 17 38 17 44 17 50 L 17 71 C 17 78 22 79 28 79 L 28 38 Z" 
    fill="#dbeafe" 
    stroke="#0f172a" 
    stroke-width="5" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
  />

  <!-- Main Newspaper Body -->
  <rect 
    x="29" 
    y="16" 
    width="53" 
    height="64" 
    rx="10" 
    fill="#ffffff" 
    stroke="#0f172a" 
    stroke-width="5.5" 
    stroke-linejoin="round" 
  />

  <!-- Top Headline Feature Box -->
  <rect 
    x="39" 
    y="27" 
    width="32" 
    height="17" 
    rx="4" 
    fill="#ffffff" 
    stroke="#121212" 
    stroke-width="4.5" 
  />

  <!-- Headline Bar 1 -->
  <rect 
    x="39" 
    y="51" 
    width="32" 
    height="5.5" 
    rx="2.75" 
    fill="#121212" 
  />

  <!-- Headline Bar 2 -->
  <rect 
    x="39" 
    y="63" 
    width="22" 
    height="5.5" 
    rx="2.75" 
    fill="#121212" 
  />
</svg>
