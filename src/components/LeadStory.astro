---
import type { Article } from '../lib/news/types';
import ArticleCard from './ArticleCard.astro';

interface Props {
  lead: Article;
  secondary: Article[];
}

const { lead, secondary } = Astro.props;
---

<section class="w-full py-10 bg-surface-soft">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    <div class="flex items-center gap-2 mb-5">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span class="font-mono-caption text-mute">TOP STORY</span>
    </div>

    <!-- items-start: without it, grid stretches the lead column to match the
         3-stacked-secondary-cards column height. ArticleCard's h-full +
         justify-between then pushes its footer to that full stretched height,
         leaving a large blank gap under the summary whenever the lead article
         has no image (its natural content is much shorter than 3 cards). -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-start">
      <div class="lg:col-span-2">
        <ArticleCard article={lead} size="lead" />
      </div>

      <div class="flex flex-col gap-5">
        {secondary.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </div>
</section>
