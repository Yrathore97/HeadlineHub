      },
      art006: {
        headline: 'تامل ناڈو کے قابل تجدید توانائی گرڈ نے 20GW کا سنگ میل عبور کیا',
        short: 'نئے شمسی منصوبوں کے ذریعے صنعتوں کی 45 فیصد بجلی کی ضروریات پوری کی جا رہی ہیں۔'
      }
    },
    bho: {
      art001: {
        headline: 'RBI रेपो रेट 6.5% प बरकरार रखलस; 7.2% GDP बढ़त के अनुमान',
        short: 'मजबूत आर्थिक स्थिति के देखत ब्याज दर में कौनो बदलाव ना कईल गइल।'
      },
      art002: {
        headline: 'ISRO INSAT-3DS उपग्रह लॉन्च करे खातिर तैयार',
        short: 'मौसम के जानकारी अउरी आपदा प्रबंधन खातिर नया सैटेलाइट जल्दिये लॉन्च होई।'
      },
      art003: {
        headline: 'बेंगलुरु में ₹1,500 करोड़ के AI टेक हब के मंजूरी मिलल',
        short: 'स्टार्टअप सब के बढ़ावा देवे खातिर नया एआई पार्क बनावल जाई।'
      },
      art004: {
        headline: 'दोसरा T20 मैच में भारत ऑस्ट्रेलिया के हरा के सीरीज में आगे',
        short: 'बल्लेबाज लोगन के शानदार प्रदर्शन से भारत 4 ओवर बाकी रहते मैच जीत लिहलस।'
      },
      art005: {
        headline: 'नई दिल्ली में इंडिया सेमीकंडक्टर समिट 2026 के भव्य शुरुआत',
        short: 'भारत में चिप कारखाना लगावे खातिर दुनिया के बड़ टेक कंपनी सब करार कइली।'
      },
      art006: {
        headline: 'तमिलनाडु में सोलर आ विंड एनर्जी 20GW के पार पहुँचल',
        short: 'नया बिजली प्रोजेक्ट सब से उद्योग के 45% जरूरत पूरा हो रहल बा।'
      }
    }
  };

  // State initialization & Event listener
  let currentLangCode = 'en';

  function applyLanguageTranslation(langCode: string, langName: string, stateName: string = '') {
    currentLangCode = langCode;

    // Update Badges & Labels
    const activeLangNameEl = document.getElementById('active-lang-name');
    const activeStateNameEl = document.getElementById('active-state-name');
    if (activeLangNameEl) activeLangNameEl.innerText = langName;
    if (activeStateNameEl) activeStateNameEl.innerText = stateName ? `(${stateName})` : '(All India)';

    // Update Console Preview Target Text
    const previewTargetLangLabel = document.getElementById('preview-target-lang-label');
    const previewTransHeadline = document.getElementById('preview-trans-headline');
    const previewTransShort = document.getElementById('preview-trans-short');

    if (previewTargetLangLabel) previewTargetLangLabel.innerText = `LIVE TRANSLATION • ${langName.toUpperCase()}`;

    const data = translationsMap[langCode] || translationsMap['hi'];
    if (previewTransHeadline && data) previewTransHeadline.innerText = data.art003.headline;
    if (previewTransShort && data) previewTransShort.innerText = data.art003.short;

    // Save to LocalStorage
    localStorage.setItem('userLanguage', langCode);
    localStorage.setItem('userLanguageName', langName);
    if (stateName) localStorage.setItem('userState', stateName);

    // Dispatch global event for NewsFeed and Navbar
    window.dispatchEvent(new CustomEvent('language-changed', {
      detail: { langCode, langName, stateName, translations: data }
    }));
  }

  // Handle State Cards Click
  const stateCards = document.querySelectorAll('.state-card');
  stateCards.forEach(card => {
    card.addEventListener('click', () => {
      stateCards.forEach(c => c.classList.remove('border-[#2563eb]', 'ring-1', 'ring-[#2563eb]'));
      card.classList.add('border-[#2563eb]', 'ring-1', 'ring-[#2563eb]');

      const langCode = card.getAttribute('data-langcode') || 'en';
      const langName = card.getAttribute('data-langname') || 'English';
      const stateName = card.getAttribute('data-state-name') || '';

      applyLanguageTranslation(langCode, langName, stateName);
    });
  });

  // Handle Language Buttons Click
  const langBtns = document.querySelectorAll('.lang-card-btn');
  langBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      langBtns.forEach(b => b.classList.remove('border-[#2563eb]', 'ring-1', 'ring-[#2563eb]'));
      btn.classList.add('border-[#2563eb]', 'ring-1', 'ring-[#2563eb]');

      const langCode = btn.getAttribute('data-langcode') || 'en';
      const langName = btn.getAttribute('data-langname') || 'English';

      applyLanguageTranslation(langCode, langName);
    });
  });

  // Handle Region Filter Tabs
  const regionTabs = document.querySelectorAll('.region-tab');
  const visibleStateCountEl = document.getElementById('visible-state-count');

  regionTabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      regionTabs.forEach(t => {
        t.className = 'region-tab px-3 py-1.5 text-xs font-medium rounded-lg shrink-0 transition-all cursor-pointer bg-white dark:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#262626] hover:border-[#a1a1a1]';
      });
      const target = e.target as HTMLElement;
      target.className = 'region-tab px-3 py-1.5 text-xs font-medium rounded-lg shrink-0 transition-all cursor-pointer bg-[#171717] dark:bg-white text-white dark:text-[#171717] shadow-sm';

      const selectedRegion = target.getAttribute('data-region');
      let visibleCount = 0;

      stateCards.forEach(c => {
        const cardRegion = c.getAttribute('data-region');
        if (selectedRegion === 'All Regions' || cardRegion === selectedRegion) {
          (c as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (c as HTMLElement).style.display = 'none';
        }
      });

      if (visibleStateCountEl) visibleStateCountEl.innerText = visibleCount.toString();
    });
  });

  // Handle Search Input Filtering
  const hubSearchInput = document.getElementById('hub-search-input') as HTMLInputElement;
  hubSearchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    let count = 0;

    stateCards.forEach(c => {
      const stateName = (c.getAttribute('data-state-name') || '').toLowerCase();
      const langName = (c.getAttribute('data-langname') || '').toLowerCase();
      const nativeLang = (c.getAttribute('data-native-lang') || '').toLowerCase();

      if (stateName.includes(query) || langName.includes(query) || nativeLang.includes(query)) {
        (c as HTMLElement).style.display = 'flex';
        count++;
      } else {
        (c as HTMLElement).style.display = 'none';
      }
    });

    if (visibleStateCountEl) visibleStateCountEl.innerText = count.toString();
  });

  // Speech Preview TTS (Text-To-Speech)
  const speechPreviewBtn = document.getElementById('speech-preview-btn');
  const speechBtnLabel = document.getElementById('speech-btn-label');
  let isSpeaking = false;

  speechPreviewBtn?.addEventListener('click', () => {
    if ('speechSynthesis' in window) {
      if (isSpeaking) {
        window.speechSynthesis.cancel();
        isSpeaking = false;
        if (speechBtnLabel) speechBtnLabel.innerText = 'Listen Sample';
        return;
      }

      const textToRead = document.getElementById('preview-trans-headline')?.innerText || 'Welcome to HeadlineHub AI News';
      const utterance = new SpeechSynthesisUtterance(textToRead);
      utterance.lang = currentLangCode === 'hi' ? 'hi-IN' : currentLangCode === 'bn' ? 'bn-IN' : currentLangCode === 'ta' ? 'ta-IN' : currentLangCode === 'te' ? 'te-IN' : currentLangCode === 'kn' ? 'kn-IN' : currentLangCode === 'ml' ? 'ml-IN' : currentLangCode === 'mr' ? 'mr-IN' : currentLangCode === 'gu' ? 'gu-IN' : currentLangCode === 'pa' ? 'pa-IN' : 'en-IN';

      utterance.onstart = () => {
        isSpeaking = true;
        if (speechBtnLabel) speechBtnLabel.innerText = 'Stop Audio';
      };
      utterance.onend = () => {
        isSpeaking = false;
        if (speechBtnLabel) speechBtnLabel.innerText = 'Listen Sample';
      };
      utterance.onerror = () => {
        isSpeaking = false;
        if (speechBtnLabel) speechBtnLabel.innerText = 'Listen Sample';
      };

      window.speechSynthesis.speak(utterance);
    } else {
      alert('Speech synthesis audio is not supported in your browser.');
    }
  });

  // Initialize from stored language on load if available
  window.addEventListener('DOMContentLoaded', () => {
    const savedLang = localStorage.getItem('userLanguage');
    const savedLangName = localStorage.getItem('userLanguageName');
    const savedState = localStorage.getItem('userState');
    if (savedLang && savedLangName) {
      applyLanguageTranslation(savedLang, savedLangName, savedState || '');
    }
  });
</script>
