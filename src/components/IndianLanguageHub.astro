    sampleShortNews: 'लद्दाख में शून्य-कार्बन ऊर्जा ग्रिड स्थापित करने के लिए विश्व बैंक समर्थित बुनियादी ढांचा परियोजना शुरू हुई।'
  }
];

const indianLanguages = [
  { code: 'hi', name: 'Hindi', native: 'हिंदी', script: 'Devanagari', isScheduled: true },
  { code: 'bn', name: 'Bengali', native: 'বাংলা', script: 'Bengali', isScheduled: true },
  { code: 'mr', name: 'Marathi', native: 'मराठी', script: 'Devanagari', isScheduled: true },
  { code: 'te', name: 'Telugu', native: 'తెలుగు', script: 'Telugu', isScheduled: true },
  { code: 'ta', name: 'Tamil', native: 'தமிழ்', script: 'Tamil', isScheduled: true },
  { code: 'gu', name: 'Gujarati', native: 'ગુજરાતી', script: 'Gujarati', isScheduled: true },
  { code: 'kn', name: 'Kannada', native: 'ಕನ್ನಡ', script: 'Kannada', isScheduled: true },
  { code: 'ml', name: 'Malayalam', native: 'മലയാളം', script: 'Malayalam', isScheduled: true },
  { code: 'pa', name: 'Punjabi', native: 'ਪੰਜਾਬੀ', script: 'Gurmukhi', isScheduled: true },
  { code: 'or', name: 'Odia', native: 'ଓଡ଼ିଆ', script: 'Odia', isScheduled: true },
  { code: 'as', name: 'Assamese', native: 'অসমীয়া', script: 'Bengali-Assamese', isScheduled: true },
  { code: 'ur', name: 'Urdu', native: 'اردو', script: 'Nastaliq', isScheduled: true },
  { code: 'bho', name: 'Bhojpuri', native: 'भोजपुरी', script: 'Devanagari', isScheduled: false },
  { code: 'ks', name: 'Kashmiri', native: 'कॉशुर', script: 'Perso-Arabic / Devanagari', isScheduled: true },
  { code: 'doi', name: 'Dogri', native: 'डोगरी', script: 'Devanagari', isScheduled: true },
  { code: 'kok', name: 'Konkani', native: 'कोंकणी', script: 'Devanagari', isScheduled: true },
  { code: 'mai', name: 'Maithili', native: 'मैथिली', script: 'Devanagari', isScheduled: true },
  { code: 'mni', name: 'Manipuri (Meitei)', native: 'ꯃꯤꯇꯩꯂꯣᓐ', script: 'Meitei Mayek', isScheduled: true },
  { code: 'sat', name: 'Santali', native: 'ᱥᱟᱱᱛᱟᱲᱤ', script: 'Ol Chiki', isScheduled: true },
  { code: 'ne', name: 'Nepali', native: 'नेपाली', script: 'Devanagari', isScheduled: true },
  { code: 'brx', name: 'Bodo', native: 'बड़ो', script: 'Devanagari', isScheduled: true },
  { code: 'sa', name: 'Sanskrit', native: 'संस्कृतम्', script: 'Devanagari', isScheduled: true },
  { code: 'sd', name: 'Sindhi', native: 'सिंधी', script: 'Devanagari', isScheduled: true },
  { code: 'en', name: 'English', native: 'English', script: 'Latin', isScheduled: false }
];

const regions = ['All Regions', 'North', 'South', 'West & Central', 'East', 'North-East', 'Union Territory'];
---

<section id="language-hub" class="w-full py-12 bg-white dark:bg-[#000000] border-y border-[#ebebeb] dark:border-[#262626] transition-colors duration-200">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 mb-2 flex-wrap">
        <div class="flex items-center gap-2 mb-2 flex-wrap">
          <span class="px-2.5 py-0.5 rounded-full bg-[#dbeafe]/80 dark:bg-[#172554] text-[#1e40af] dark:text-[#93c5fd] font-mono-caption text-[11px] font-bold border border-[#2563eb]/40">
            BHARAT BHASHA ENGINE • भारत की हर भाषा
          </span>
          <span class="flex items-center gap-1 text-xs text-[#1e40af] dark:text-[#93c5fd] font-medium bg-[#dbeafe]/80 dark:bg-[#172554] px-2 py-0.5 rounded border border-[#bfdbfe]/50 dark:border-[#1d4ed8]/50">
            <span class="w-1.5 h-1.5 rounded-full bg-[#2563eb] animate-ping"></span>
            28 States & 8 UTs Supported
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-semibold text-[#171717] dark:text-white tracking-[-1.28px]">
          Read News in <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#2563eb] via-[#3b82f6] to-[#1d4ed8]">Your State Language</span>
        </h2>
        <p class="text-sm text-[#4d4d4d] dark:text-[#a1a1aa] mt-1 max-w-2xl">
          Select any State or Indian Scheduled Language below to translate the entire news website instantly with AI speech playback.
        </p>
      </div>

      <!-- Quick Reset / Active Badge -->
      <div class="flex items-center gap-3">
        <div id="active-lang-badge" class="flex items-center gap-2 px-3 py-1.5 bg-[#fafafa] dark:bg-[#141414] border border-[#bfdbfe] dark:border-[#1e293b] rounded-lg text-xs font-mono text-[#171717] dark:text-white shadow-sm">
          <span class="text-[#888888]">Active:</span>
          <span id="active-lang-name" class="font-bold text-[#1d4ed8] dark:text-[#60a5fa]">English</span>
          <span id="active-state-name" class="text-[#888888] text-[11px]">(All India)</span>
        </div>

        <button 
          id="speech-preview-btn"
          type="button"
          class="px-3.5 py-1.5 bg-[#171717] dark:bg-white text-white dark:text-[#171717] hover:bg-[#333333] dark:hover:bg-[#e5e5e5] rounded-lg text-xs font-semibold shadow-sm transition-all flex items-center gap-1.5 cursor-pointer shrink-0"
        >
          <svg class="w-3.5 h-3.5 text-[#2563eb] dark:text-[#60a5fa]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
          <span id="speech-btn-label">Listen Sample</span>
        </button>
      </div>
    </div>

    <!-- Quick Search & Region Filter Bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-6 bg-[#fafafa] dark:bg-[#0a0a0a] p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626]">
      
      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <input 
          type="text" 
          id="hub-search-input" 
          placeholder="Search State or Language (e.g. Maharashtra, Tamil, Punjabi, Assamese)..." 
          class="w-full bg-white dark:bg-[#141414] border border-[#bfdbfe] dark:border-[#1e293b] text-[#171717] dark:text-white placeholder-[#888888] rounded-lg pl-9 pr-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-[#2563eb]"
        />
        <svg class="w-4 h-4 text-[#888888] absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>

      <!-- Region Filter Tabs -->
      <div class="flex items-center gap-1 overflow-x-auto no-scrollbar py-1">
        {regions.map((reg, idx) => (
          <button 
            type="button"
            class={`region-tab px-3 py-1.5 text-xs font-medium rounded-lg shrink-0 transition-all cursor-pointer ${
              idx === 0 
                ? 'bg-[#171717] dark:bg-white text-white dark:text-[#171717] shadow-sm' 
                : 'bg-white dark:bg-[#141414] text-[#4d4d4d] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#262626] hover:border-[#a1a1a1]'
            }`}
            data-region={reg}
          >
            {reg}
          </button>
        ))}
      </div>
    </div>

    <!-- Main Grid Layout: Languages List + States Selector -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8">
      
      <!-- Left Column: Indian Languages Native Buttons (4 Cols) -->
      <div class="lg:col-span-4 bg-[#fafafa] dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-xl p-4 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#262626] pb-3 mb-3">
            <span class="text-xs font-mono-caption text-[#888888]">SELECT BY LANGUAGE</span>
            <span class="text-[11px] text-[#1d4ed8] dark:text-[#60a5fa] font-semibold">22 Scheduled + Regional</span>
          </div>

          <!-- Language Buttons Grid -->
          <div class="grid grid-cols-2 gap-2 max-h-[360px] overflow-y-auto pr-1 no-scrollbar" id="lang-buttons-container">
            {indianLanguages.map((lang) => (
              <button
                type="button"
                class="lang-card-btn p-2.5 rounded-lg border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] hover:border-[#2563eb] dark:hover:border-[#3b82f6] transition-all text-left group cursor-pointer"
                data-langcode={lang.code}
                data-langname={lang.name}
                data-nativename={lang.native}
              >
                <div class="flex items-center justify-between mb-0.5">
                  <span class="text-sm font-semibold text-[#171717] dark:text-white group-hover:text-[#1d4ed8] dark:group-hover:text-[#60a5fa] transition-colors">{lang.native}</span>
                  {lang.isScheduled && (
                    <span class="w-1.5 h-1.5 rounded-full bg-[#2563eb]" title="Official Scheduled Language"></span>
                  )}
                </div>
                <div class="flex items-center justify-between text-[11px] text-[#888888] font-mono">
                  <span>{lang.name}</span>
                  <span>{lang.script}</span>
                </div>
              </button>
            ))}
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-[#ebebeb] dark:border-[#262626] flex items-center justify-between text-xs text-[#888888]">
          <span>AI Speech Supported</span>
          <span class="font-mono text-[#1d4ed8] dark:text-[#60a5fa]">Auto-Detect State</span>
        </div>
      </div>

      <!-- Right Column: Interactive State Selector Cards (8 Cols) -->
      <div class="lg:col-span-8 space-y-4">
        
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono-caption text-[#888888]">SELECT BY STATE & UNION TERRITORY</span>
          <span class="text-xs text-[#4d4d4d] dark:text-[#a1a1aa]">Showing <strong id="visible-state-count" class="text-[#171717] dark:text-white">{indianStates.length}</strong> States/UTs</span>
        </div>

        <!-- States Grid -->
        <div id="states-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 max-h-[380px] overflow-y-auto pr-1">
          {indianStates.map((st) => (
            <div 
              class="state-card p-3 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0a0a0a] hover:border-[#2563eb] dark:hover:border-[#3b82f6] hover:shadow-stacked-sm transition-all cursor-pointer group flex flex-col justify-between"
              data-state-id={st.id}
              data-state-name={st.name}
              data-region={st.region}
              data-langcode={st.langCode}
              data-langname={st.primaryLang}
              data-native-lang={st.nativeLangName}
              data-headline={st.sampleHeadline}
              data-shortnews={st.sampleShortNews}
            >
              <div>
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2">
                    <span class="text-base">{st.flagIcon}</span>
                    <span class="text-xs font-bold text-[#171717] dark:text-white group-hover:text-[#1d4ed8] dark:group-hover:text-[#60a5fa] transition-colors">{st.name}</span>
                  </div>
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#f5f5f5] dark:bg-[#1f1f1f] text-[#888888] border border-[#ebebeb] dark:border-[#262626]">
                    {st.code}
                  </span>
                </div>
                <div class="text-[11px] text-[#4d4d4d] dark:text-[#a1a1aa] flex items-center justify-between">
                  <span>Language: <strong class="text-[#171717] dark:text-white">{st.nativeLangName}</strong></span>
                  <span class="font-mono text-[10px] text-[#888888]">{st.region}</span>
                </div>
              </div>

              <!-- Action Indicator -->
              <div class="mt-2.5 pt-2 border-t border-[#f5f5f5] dark:border-[#1a1a1a] flex items-center justify-between text-[11px] text-[#1d4ed8] dark:text-[#60a5fa] font-medium opacity-80 group-hover:opacity-100">
                <span>Translate Site to {st.primaryLang}</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>

    <!-- Live Translation Console Preview Banner -->
    <div class="bg-[#171717] dark:bg-[#0a0a0a] border border-[#262626] text-white rounded-xl p-5 sm:p-6 shadow-stacked-lg flex flex-col md:flex-row items-stretch justify-between gap-6">
      
      <!-- Source (English Wire) -->
      <div class="flex-1 space-y-2 border-b md:border-b-0 md:border-r border-[#333333] pb-4 md:pb-0 md:pr-6">
        <div class="flex items-center gap-2 text-xs font-mono text-[#888888]">
          <span class="w-2 h-2 rounded-full bg-[#2563eb]"></span>
          <span>ORIGINAL ENGLISH WIRE</span>
          <span class="px-1.5 py-0.5 bg-[#262626] rounded text-[10px]">Source News</span>
        </div>
        <h3 id="preview-orig-headline" class="text-base font-semibold text-white leading-snug">
          Karnataka Cabinet Approves ₹1,500 Cr AI Tech Hub in Bengaluru
        </h3>
        <p id="preview-orig-short" class="text-xs text-[#a1a1a1] leading-relaxed">
          Karnataka announces a flagship GPU compute credit program and specialized AI innovation parks across Bengaluru to incubate deep-tech startups.
        </p>
      </div>

      <!-- Arrow Indicator -->
      <div class="hidden md:flex items-center justify-center shrink-0">
        <div class="w-10 h-10 rounded-full bg-[#262626] border border-[#404040] flex items-center justify-center text-[#50e3c2]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </div>
      </div>

      <!-- Target (State Language Live Translation) -->
      <div class="flex-1 space-y-2">
        <div class="flex items-center justify-between text-xs font-mono">
          <div class="flex items-center gap-2 text-[#50e3c2]">
            <span class="w-2 h-2 rounded-full bg-[#50e3c2] animate-pulse"></span>
            <span id="preview-target-lang-label">LIVE TRANSLATION • KANNADA</span>
          </div>
          <span class="px-2 py-0.5 bg-[#50e3c2]/10 text-[#50e3c2] border border-[#50e3c2]/30 rounded text-[10px] font-bold">
            AI Neural Engine
          </span>
        </div>

        <h3 id="preview-trans-headline" class="text-base font-semibold text-[#ffffff] leading-snug tracking-wide">
          ಕರ್ನಾಟಕ ಸಚಿವ ಸಂಪುಟದಿಂದ ಬೆಂಗಳೂರಿನಲ್ಲಿ ₹1,500 ಕೋಟಿ ಎಐ ಟೆಕ್ ಹಬ್‌ಗೆ ಅನುಮೋದನೆ
        </h3>
        <p id="preview-trans-short" class="text-xs text-[#d1d5db] leading-relaxed">
          ಆಳವಾದ ತಂತ್ರಜ್ಞಾನ ನವೋದ್ಯಮಗಳನ್ನು ಬೆಳೆಸಲು ಬೆಂಗಳೂರಿನಾದ್ಯಂತ ಜಿಪಿಯು ಕಂಪ್ಯೂಟ್ ಕ್ರೆಡಿಟ್ ಕಾರ್ಯಕ್ರಮ ಮತ್ತು ಎಐ ಆವಿಷ್ಕಾರ ಪಾರ್ಕ್‌ಗಳನ್ನು ಶೀಘ್ರವೇ ಸ್ಥಾಪಿಸಲಾಗುವುದು.
        </p>
      </div>

    </div>

  </div>
</section>

<script>
  // Translations dictionary for dynamic live translation of mock news across the entire website
  const translationsMap: Record<string, {
    art001: { headline: string; short: string };
    art002: { headline: string; short: string };
    art003: { headline: string; short: string };
    art004: { headline: string; short: string };
    art005: { headline: string; short: string };
    art006: { headline: string; short: string };
  }> = {
    hi: {
      art001: {
        headline: 'आरबीआई ने रेपो दर 6.5% पर बरकरार रखी, 7.2% जीडीपी वृद्धि का अनुमान',
        short: 'आरबीआई मौद्रिक नीति समिति ने मजबूत आर्थिक बुनियादी सिद्धांतों और स्थिर मुद्रास्फीति का हवाला देते हुए बेंचमार्क रेपो दर को 6.5% पर बनाए रखा।'
      },
      art002: {
        headline: 'इसरो ने श्रीहरिकोटा से INSAT-3DS उपग्रह प्रक्षेपण की तैयारी पूरी की',
        short: 'भारतीय अंतरिक्ष अनुसंधान संगठन ने मौसम पूर्वानुमान और आपदा ट्रैकिंग क्षमताओं का विस्तार करने के लिए अंतिम पेलोड पूरा किया।'
      },
      art003: {
        headline: 'कर्नाटक कैबिनेट ने बेंगलुरु में ₹1,500 करोड़ के AI टेक हब को मंजूरी दी',
        short: 'कर्नाटक ने गहरे तकनीकी स्टार्टअप को बढ़ावा देने के लिए बेंगलुरु में जीपीयू कंप्यूट क्रेडिट कार्यक्रम की घोषणा की।'
      },
      art004: {
        headline: 'दूसरे टी-20 मैच में भारत ने ऑस्ट्रेलिया को करारी शिकस्त दी',
        short: 'शीर्ष क्रम के शानदार प्रदर्शन की बदौलत भारत ने एम चिन्नास्वामी स्टेडियम में 4 ओवर शेष रहते आसान जीत हासिल की।'
      },
      art005: {
        headline: 'नई दिल्ली में इंडिया सेमीकंडक्टर समिट 2026 का भव्य उद्घाटन',
        short: 'वैश्विक टेक दिग्गजों ने भारत में बहु-अरब डॉलर के नए फैब्रिकेशन प्लांट निवेश की अंतिम योजनाओं की घोषणा की।'
      },
      art006: {
        headline: 'तमिलनाडु नवीकरणीय ऊर्जा ग्रिड ने 20GW का मील का पत्थर पार किया',
        short: 'नई पवन-सौर परियोजनाओं के साथ तमिलनाडु अब स्वच्छ ऊर्जा से 45% से अधिक औद्योगिक बिजली मांग पूरी करता है।'
      }
    },
    bn: {
      art001: {
        headline: 'আরবিআই রেপো রেট ৬.৫% এ অপরিবর্তিত রেখেছে, ৭.২% জিডিপি বৃদ্ধির পূর্বাভাস',
        short: 'শক্তিশালী ম্যাক্রো-অর্থনৈতিক বুনিয়াদ এবং স্থিতিশীল মুদ্রাস্ফীতির পূর্বাভাসের কথা উল্লেখ করে রেপো রেট অপরিবর্তিত রাখা হয়েছে।'
      },
      art002: {
        headline: 'শ্রীহরিকোটা থেকে ইসরো INSAT-3DS স্যাটেলাইট উৎক্ষেপণের প্রস্তুতি সম্পন্ন করেছে',
