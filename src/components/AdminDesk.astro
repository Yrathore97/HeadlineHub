---
const queueClaims = [
  { id: 'FC-9912', claim: 'State Govt announces new tax exemption scheme for agricultural land transfers.', category: 'Elections & Agriculture', risk: 'High', date: '5 mins ago' },
  { id: 'FC-9915', claim: 'Local water supply disruption scheduled in District 4 due to pipeline repairs.', category: 'Hyperlocal Public Health', risk: 'Medium', date: '12 mins ago' },
];
---

<section id="admin-desk" class="w-full py-12 bg-white dark:bg-[#000000] border-b border-[#ebebeb] dark:border-[#262626] transition-colors duration-200">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <span class="font-mono-caption text-[#0070f3]">OPERATIONS & CONTROL PANEL</span>
        <h2 class="text-2xl sm:text-3xl font-semibold text-[#171717] dark:text-white tracking-[-0.96px]">
          Operations Desk & Moderation Queue
        </h2>
      </div>

      <div class="flex items-center gap-2">
        <button id="refresh-crawler-btn" type="button" class="px-3 py-1 bg-[#0070f3] hover:bg-[#0761d1] text-white rounded text-xs font-semibold shadow-sm transition-all flex items-center gap-1.5 cursor-pointer">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          <span id="crawler-btn-text">Sync Crawler</span>
        </button>
        <span class="px-3 py-1 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-[#262626] text-[#171717] dark:text-white rounded font-mono text-xs">
          Role: Super Admin
        </span>
      </div>
    </div>

    <!-- Operational Notification Banner -->
    <div id="admin-toast-banner" class="hidden mb-6 p-3 bg-[#e0f2fe] dark:bg-[#075985] text-[#0284c7] dark:text-[#38bdf8] text-xs font-medium rounded-xl border border-[#bae6fd] dark:border-[#0369a1] animate-fade-in">
      Action status updated successfully.
    </div>

    <!-- Analytics & Health Dashboard Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      
      <div class="bg-[#fafafa] dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-xl p-4 shadow-stacked-sm">
        <div class="text-xs font-mono-caption text-[#888888] mb-1">CRAWLER STATUS</div>
        <div id="stat-sources" class="text-2xl font-bold text-[#171717] dark:text-white tracking-tight">142 Sources</div>
        <div class="text-xs text-[#29bc9b] dark:text-[#34d399] mt-1 flex items-center gap-1 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-[#29bc9b]"></span>
          <span id="stat-rate">1,480 articles scraped/hr</span>
        </div>
      </div>

      <div class="bg-[#fafafa] dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-xl p-4 shadow-stacked-sm">
        <div class="text-xs font-mono-caption text-[#888888] mb-1">FACT-CHECK QUEUE</div>
        <div id="stat-queue-count" class="text-2xl font-bold text-[#171717] dark:text-white tracking-tight">2 Pending</div>
        <div class="text-xs text-[#ab570a] dark:text-[#f5a623] mt-1 flex items-center gap-1 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-[#f5a623]"></span>
          High-Stakes Election Claim
        </div>
      </div>

      <div class="bg-[#fafafa] dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-xl p-4 shadow-stacked-sm">
        <div class="text-xs font-mono-caption text-[#888888] mb-1">LIVE MONETIZATION (RPM)</div>
        <div class="text-2xl font-bold text-[#171717] dark:text-white tracking-tight">$4.85 RPM</div>
        <div class="text-xs text-[#0070f3] mt-1 flex items-center gap-1 font-medium">
          AdSense + Subscriptions Active
        </div>
      </div>

      <div class="bg-[#fafafa] dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-xl p-4 shadow-stacked-sm">
        <div class="text-xs font-mono-caption text-[#888888] mb-1">DAILY READERSHIP</div>
        <div class="text-2xl font-bold text-[#171717] dark:text-white tracking-tight">1.2M Views</div>
        <div class="text-xs text-[#29bc9b] dark:text-[#34d399] mt-1 flex items-center gap-1 font-medium">
          +18.4% from yesterday
        </div>
      </div>

    </div>

    <!-- Human Review Queue Table -->
    <div class="bg-[#fafafa] dark:bg-[#0a0a0a] border border-[#ebebeb] dark:border-[#262626] rounded-xl overflow-hidden shadow-stacked-sm">
      <div class="px-5 py-4 bg-white dark:bg-[#141414] border-b border-[#ebebeb] dark:border-[#262626] flex items-center justify-between">
        <h3 class="text-sm font-semibold text-[#171717] dark:text-white flex items-center gap-2">
          <svg class="w-4 h-4 text-[#ee0000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          Fact-Check Human Moderation Desk
        </h3>
        <span class="text-xs font-mono text-[#888888]">Auto-routed by AI Verification Pipeline</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-[#171717] dark:text-[#a1a1a1]">
          <thead class="bg-[#fafafa] dark:bg-[#0a0a0a] text-[#888888] font-mono-caption border-b border-[#ebebeb] dark:border-[#262626]">
            <tr>
              <th class="px-4 py-3">Audit ID</th>
              <th class="px-4 py-3">Submitted Claim</th>
              <th class="px-4 py-3">Category</th>
              <th class="px-4 py-3">Risk Level</th>
              <th class="px-4 py-3 text-right">Moderator Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#ebebeb] dark:divide-[#262626] bg-white dark:bg-[#141414]">
            {queueClaims.map((item) => (
              <tr data-row-id={item.id} class="hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] transition-colors">
                <td class="px-4 py-3 font-mono font-medium text-[#0070f3]">{item.id}</td>
                <td class="px-4 py-3 max-w-xs font-medium text-[#171717] dark:text-white">{item.claim}</td>
                <td class="px-4 py-3 text-[#4d4d4d] dark:text-[#a1a1a1]">{item.category}</td>
                <td class="px-4 py-3">
                  <span class={`px-2 py-0.5 rounded text-[11px] font-semibold ${item.risk === 'High' ? 'bg-[#f7d4d6] dark:bg-[#521b1e] text-[#ee0000] dark:text-[#ff6b6b]' : 'bg-[#ffefcf] dark:bg-[#4a3410] text-[#ab570a] dark:text-[#f5a623]'}`}>
                    {item.risk} Risk
                  </span>
                </td>
                <td class="px-4 py-3 text-right space-x-2">
                  <button data-action="approve" data-id={item.id} type="button" class="action-approve-btn px-2.5 py-1 bg-[#171717] dark:bg-white hover:bg-[#333333] dark:hover:bg-[#e5e5e5] text-white dark:text-[#171717] rounded text-[11px] font-medium transition-colors cursor-pointer">
                    Approve Verdict
                  </button>
                  <button data-action="reject" data-id={item.id} type="button" class="action-reject-btn px-2.5 py-1 bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#ebebeb] dark:hover:bg-[#262626] border border-[#ebebeb] dark:border-[#262626] text-[#ee0000] rounded text-[11px] font-medium transition-colors cursor-pointer">
                    Reject Claim
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<script>
  const toastBanner = document.getElementById('admin-toast-banner');
  const refreshBtn = document.getElementById('refresh-crawler-btn');
  const crawlerText = document.getElementById('crawler-btn-text');
  const statRate = document.getElementById('stat-rate');
  let pendingCount = 2;

  function showToast(msg: string) {
    if (toastBanner) {
      toastBanner.innerText = msg;
      toastBanner.classList.remove('hidden');
      setTimeout(() => {
        toastBanner.classList.add('hidden');
      }, 4000);
    }
  }

  // Refresh Crawler Sync
  refreshBtn?.addEventListener('click', () => {
    if (crawlerText) crawlerText.innerText = 'Syncing...';
    setTimeout(() => {
      if (crawlerText) crawlerText.innerText = 'Sync Crawler';
      if (statRate) statRate.innerText = `${1500 + Math.floor(Math.random() * 50)} articles scraped/hr`;
      showToast('Crawler nodes synchronized with tier-1 wire services.');
    }, 600);
  });

  // Action Buttons Handler
  document.querySelectorAll('.action-approve-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
      const row = (e.currentTarget as HTMLElement).closest('tr');
      if (row) {
        row.style.opacity = '0.4';
        (btn as HTMLButtonElement).disabled = true;
        (btn as HTMLButtonElement).innerText = 'Approved';
      }
      pendingCount = Math.max(0, pendingCount - 1);
      const queueStat = document.getElementById('stat-queue-count');
      if (queueStat) queueStat.innerText = `${pendingCount} Pending`;
      showToast(`Audit ID ${id} approved & published to live feed.`);
    });
  });

  document.querySelectorAll('.action-reject-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
      const row = (e.currentTarget as HTMLElement).closest('tr');
      if (row) {
        row.style.opacity = '0.4';
        (btn as HTMLButtonElement).disabled = true;
        (btn as HTMLButtonElement).innerText = 'Rejected';
      }
      pendingCount = Math.max(0, pendingCount - 1);
      const queueStat = document.getElementById('stat-queue-count');
      if (queueStat) queueStat.innerText = `${pendingCount} Pending`;
      showToast(`Audit ID ${id} rejected & moved to archives.`);
    });
  });
</script>
