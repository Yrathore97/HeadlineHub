---
import '../styles/global.css';
import SavedArticlesPanel from '../components/SavedArticlesPanel.astro';
import TopicsPanel from '../components/TopicsPanel.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const SITE = 'https://newzwale.editall.workers.dev';

const {
  title = 'NewzWale | Only Facts News',
  description = 'Live Indian news headlines, plus a fact-check tool that checks claims against published fact-checkers and real sources before returning a verdict.',
  image = `${SITE}/web-app-manifest-512x512.png`
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="NewzWale" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Match the browser chrome to --color-canvas in each theme. -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a18" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GB803SMK37"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GB803SMK37');
    </script>

    <!-- Anti-FOUC Dark Mode Inline Initialization Script -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="news, news today, google news, breaking news, latest news, tech news, hindi news, news in hindi, india news, fact check, fact check status true, fact check explorer, fact check india, newzwale, real-time news" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="NewzWale Autonomous Media Network" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="NewzWale" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NewzWale - Latest News, India News & AI Fact Check Portal" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:locale:alternate" content="hi_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@NewzWale" />
    <meta name="twitter:creator" content="@NewzWale" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="NewzWale - Latest News, India News & AI Fact Check Portal" />

    <!-- Schema Markup JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "NewsMediaOrganization",
        "name": "NewzWale",
        "alternateName": ["NewzWale News", "NewzWale India"],
        "url": SITE,
        "logo": {
          "@type": "ImageObject",
          "url": `${SITE}/web-app-manifest-512x512.png`,
          "width": 512,
          "height": 512
        },
        "knowsLanguage": ["en"]
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "NewzWale",
        "url": SITE
      }
    ])} />
  </head>
  <body class="bg-surface-soft text-ink min-h-screen flex flex-col antialiased transition-colors duration-200">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-ink focus:text-canvas focus:rounded-md focus:shadow-stacked-md"
    >
      Skip to Main Content
    </a>
    <div id="nav-progress" aria-hidden="true" class="fixed top-0 left-0 z-[200] h-[3px] w-0 bg-primary-strong opacity-0"></div>
    <SavedArticlesPanel />
    <TopicsPanel />
    <slot />

    <script>
      // Full-page navigations (category links, pagination, language switch)
      // give no visual feedback until the next page paints. A thin top bar
      // that eases toward 90% on click, then lets the incoming page's own
      // load/unload finish it, is the smallest honest way to say "working" -
      // it never claims completion the click hasn't earned yet. The easing
      // is a plain CSS transition (cubic-bezier front-loads the motion, like
      // the manual step-toward-90% loop this replaced) rather than a
      // setInterval driving the width by hand.
      const bar = document.getElementById('nav-progress');
      if (bar) {
        const start = () => {
          bar.style.transition = 'width 4s cubic-bezier(0.1, 0.7, 0.3, 1), opacity 200ms ease-out';
          bar.style.opacity = '1';
          bar.style.width = '90%';
        };

        document.addEventListener('click', (e) => {
          const link = (e.target as HTMLElement)?.closest('a');
          if (!link) return;
          const href = link.getAttribute('href');
          if (!href || href.startsWith('#')) return;
          if (link.target === '_blank' || e.defaultPrevented || e.metaKey || e.ctrlKey) return;
          let url: URL;
          try {
            url = new URL(href, window.location.href);
          } catch {
            return;
          }
          if (url.origin !== window.location.origin) return;
          start();
        });

        window.addEventListener('pageshow', () => {
          bar.style.transition = 'none';
          bar.style.width = '0%';
          bar.style.opacity = '0';
        });
      }
    </script>
  </body>
</html>
