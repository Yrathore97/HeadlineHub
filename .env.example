# UncosHub AI Environment Configuration

ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:4321

# Strict CORS origins (comma-separated, no wildcard with credentials)
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,https://uncoshub.ai

# Database PostgreSQL Connection
DATABASE_URL=postgresql://uncosuser:uncospassword@localhost:5432/uncosdb

# JWT Authentication Secrets
JWT_SECRET=super-secret-uncoshub-ai-key-change-this-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth 2.0 OpenID Connect PKCE
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Sarvam AI Voice TTS (Bulbul V3 Primary Engine)
SARVAM_API_KEY=your_sarvam_ai_api_key_here

# ElevenLabs Fallback TTS Key (Optional English Studio Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# LLM Grounded Chat Provider API Key
LLM_API_KEY=your_llm_provider_api_key_here
